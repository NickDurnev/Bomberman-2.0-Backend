{
  "name": "bomberman-2.0-backend",
  "version": "1.0.0",
  "description": "Bomberman 2.0 backend server",
  "main": "server.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc",
    "postbuild": "copyfiles -u 1 src/maps/* dist",
    "lint:fix": "biome lint --write .",
    "lint-staged": "lint-staged",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome ci .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "_moduleAliases": {
    "@services": "./dist/services",
    "@entity": "./dist/entity",
    "@routes": "./dist/routes",
    "@middlewares": "./dist/middlewares",
    "@db": "./dist/db",
    "@types": "./dist/types",
    "@constants": "./dist/constants"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cloudinary": "^2.5.1",
    "copyfiles": "^2.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "module-alias": "^2.2.3",
    "mongoose": "^8.5.1",
    "node-cron": "^3.0.3",
    "socket.io": "^4.8.1",
    "typescript": "^7.0.2",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.8.7",
    "@types/node-cron": "^3.0.11",
    "@types/socket.io": "^3.0.2",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
